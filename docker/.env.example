# 复制成同目录 .env 后填真值（.env 已在 .gitignore 里排除，禁止入库）。
# compose 的 env_file 把它整份注入 csmig-backend 容器，application-pro.yml 里对应项只有 ${MIG_*:} 占位。
# 本清单与 pro 文件引用的变量逐字对齐；不填即空串，被对应能力按「未配置」失败关闭。

SPRING_PROFILES_ACTIVE=pro

# 连接串里的 host 用 host.docker.internal：MySQL 是宿主机进程，不是容器（库名沿用 mip_gateway）
MIG_DB_URL=jdbc:mysql://host.docker.internal:3306/mip_gateway?useUnicode=true&characterEncoding=utf8&zeroDateTimeBehavior=convertToNull&useSSL=false&serverTimezone=Asia/Shanghai&allowPublicKeyRetrieval=true&createDatabaseIfNotExist=true
MIG_DB_USERNAME=
MIG_DB_PASSWORD=

# 医保局端（csmis）上游地址：132 上 csmis 后端映射在宿主 8010；不填则回落 pro 文件里的 localhost 默认值（只够本机联调）
MIG_UPSTREAM_URL=http://host.docker.internal:8010/mss

# 院内段/局端段 SM4 会话密钥（32位十六进制，分别与 HIS 侧、医保局端 jinb.crypto.sm4-key 一致）；
# 不填则国密报文加解密失败，医保链路不可用
MIG_SM4_KEY_HIS=
MIG_SM4_KEY_MSS=


# JWT 签名密钥（生产必须覆盖；不填则 token 签发/校验不可用）
MIG_JWT_SECRET=

# 报文国密开关（默认 true=SM2 签名 + SM4 加密 + 证书链验签；密钥/证书已打包在镜像 classpath）
# MIG_CRYPTO_ENABLED=true

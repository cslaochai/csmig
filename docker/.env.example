# 复制成同目录 .env 后填真值（.env 已在 .gitignore 里排除，禁止入库）。
# compose 的 env_file 把它整份注入 csmig-backend 容器，application.yml 里对应项只有 ${MIP_*:} 占位。

# 连接串里的 host 用 host.docker.internal：MySQL 是宿主机进程，不是容器
MIP_DB_URL=jdbc:mysql://host.docker.internal:3306/mip_gateway?useUnicode=true&characterEncoding=utf8&zeroDateTimeBehavior=convertToNull&useSSL=false&serverTimezone=Asia/Shanghai&allowPublicKeyRetrieval=true&createDatabaseIfNotExist=true
MIP_DB_USERNAME=
MIP_DB_PASSWORD=

# 医保局端（csmis）上游地址：132 上 csmis 后端映射在宿主 8010
MIP_UPSTREAM_URL=http://host.docker.internal:8010/mss

# 登录口令传输加密 SM2 私钥（16进制 64 字符）；不填则每次启动临时生成，重启后前端缓存的公钥失效
MIP_SM2_PRIVATE_KEY=

# JWT 签名密钥（生产必须覆盖）
MIP_JWT_SECRET=

# 报文国密开关（默认 true=SM2 签名 + SM4 加密 + 证书链验签；密钥/证书已打包在镜像 classpath）
# MIP_CRYPTO_ENABLED=true
# MIP_SM4_KEY_HIS=
# MIP_SM4_KEY_MSS=
